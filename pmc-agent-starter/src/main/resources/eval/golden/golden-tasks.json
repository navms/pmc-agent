        { "id": "no_export", "kind": "forbidden_agent", "value": "export_excel" },
        { "id": "no_chart", "kind": "forbidden_agent", "value": "create_chart" },
        { "id": "no_interrupt", "kind": "interrupt", "value": false }
      ]
    }
  },
